{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "Database": {
    "MigrateOnStartup": false,
    "SeedOnStartup": false
  },
  "PosCache": {
    "InstanceName": "pos-staging:"
  },
  "DurableDelivery": {
    "Enabled": false,
    "Exchange": "retailpos.integration.staging"
  },
  "MobileStockTake": {
    "Submission": {
      "WorkerEnabled": true
    }
  },
  "Elasticsearch": {
    "Enabled": false,
    "IndexPrefix": "retailpos-staging"
  },
  "FeatureFlags": {
    "StockCountPhase3Enabled": true
  }
}
