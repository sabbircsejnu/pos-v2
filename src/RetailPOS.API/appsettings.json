{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Information"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "",
    "Redis": ""
  },
  "Database": {
    "MigrateOnStartup": false,
    "SeedOnStartup": false
  },
  "PosCache": {
    "InstanceName": "pos:",
    "LookupTtlMinutes": 10,
    "PriceTtlMinutes": 5,
    "StockHintTtlSeconds": 30
  },
  "Elasticsearch": {
    "Enabled": false
  },
  "JwtSettings": {
    "Issuer": "RetailPOSAPI",
    "Audience": "RetailPOSClient",
    "ExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 7
  },
  "FinancialPosting": {
    "HostRole": "Api",
    "Sales": {
      "WorkerEnabled": true,
      "PollIntervalSeconds": 5,
      "BatchSize": 25,
      "BaseRetrySeconds": 30,
      "MaxRetrySeconds": 3600,
      "AwaitingSaleRetrySeconds": 30
    },
    "CashDifferences": {
      "WorkerEnabled": true,
      "PollIntervalSeconds": 60,
      "BatchSize": 20
    }
  },
  "FeatureFlags": {
    "StockCountPhase3Enabled": true,
    "StockCountAsyncAdjustmentEnabled": false
  }
}
