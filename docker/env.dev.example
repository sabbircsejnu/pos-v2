# Copy to .env.dev (gitignored). Use actual secrets, never commit them.
# For a data-preserving cutover, reuse the existing legacy credentials (from user-secrets) so the API needs no change.
# Kibana and pgAdmin are required Development services (Compose `admin` profile); always enabled for the standard startup.
COMPOSE_PROFILES=admin
DEV_POSTGRES_DB=retailpos_db
DEV_POSTGRES_USER=admin
DEV_POSTGRES_PASSWORD=CHANGE_ME
DEV_POSTGRES_PORT=5435
DEV_RABBITMQ_USER=CHANGE_ME
DEV_RABBITMQ_PASSWORD=CHANGE_ME
DEV_RABBITMQ_VHOST=retailpos_dev
DEV_RABBITMQ_PORT=5672
DEV_RABBITMQ_MGMT_PORT=15672
DEV_REDIS_PASSWORD=CHANGE_ME
DEV_REDIS_PORT=6382
DEV_ELASTIC_PASSWORD=CHANGE_ME
DEV_ELASTIC_PORT=9200
# Applied to Elasticsearch by the kibana-bootstrap one-shot service (admin profile). No double quotes or backslashes.
DEV_KIBANA_SYSTEM_PASSWORD=CHANGE_ME
DEV_KIBANA_PORT=5601
DEV_PGADMIN_EMAIL=admin@example.com
DEV_PGADMIN_PASSWORD=CHANGE_ME
DEV_PGADMIN_PORT=8081
